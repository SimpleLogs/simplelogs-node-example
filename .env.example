# Settings -> API Keys in the SimpleLogs dashboard.
#
# The server key is secret. It is never sent to a browser, and .env is
# gitignored so it does not get committed.
SIMPLELOGS_SERVER_KEY=sk_replace_me

# Optional. Self-hosted installs only — the SDK defaults to the hosted
# collector.
# SIMPLELOGS_API_ENDPOINT=https://app.simplelogs.io/api/v1
